{
  "name": "C",
  "build": {
    "dockerfile": "./build.Dockerfile",
    "context": ".."
  },
  "runArgs": ["--platform=linux/amd64"],
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "extensions.verifySignature": false
      },
      "extensions": ["charliermarsh.ruff", "ms-python.python", "ms-python.vscode-pylance", "ms-python.debugpy", "njpwerner.autodocstring"]
    }
  }
}